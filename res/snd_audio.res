// Généré par tools/music/make_music.py : ne pas modifier à la main.
// Musique : une ressource XGM2 multi-pistes (échantillons de percussions partagés).
XGM2 xgm2_music "music/title.vgm" "music/year1.vgm" "music/report.vgm" "music/year2.vgm" "music/year3.vgm" "music/year4.vgm" "music/year5.vgm" "music/election.vgm" "music/event.vgm" "music/assembly.vgm" "music/map.vgm" "music/budget.vgm" "music/referendum.vgm" "music/reshuffle.vgm" "music/impeach.vgm" "music/campaign.vgm" "music/mandate2.vgm" "music/end_win.vgm" "music/end_lose.vgm" "music/scores.vgm" "music/help.vgm"
// Bruitages : canal PCM 2 de XGM2 (13 300 Hz).
WAV sfx_move "sfx/sfx_move.wav" XGM2
WAV sfx_ok "sfx/sfx_ok.wav" XGM2
WAV sfx_cancel "sfx/sfx_cancel.wav" XGM2
